# Minimum brightness percentage — never set below this to avoid turning off the display.
MIN_BRIGHTNESS=5

# Sensor source:
#   hybrid – built-in ALS → camera → remote, first that works (default)
#   local  – only the built-in ambient light sensor (IIO/sysfs)
#   camera – only the webcam
#   remote – only the SensorServer WebSocket lux sensor
SENSOR_MODE=hybrid

# OpenTone: Match display color temperature to ambient lighting using camera + Redshift
#   true  – automatically adjust display color temperature alongside brightness (default)
#   false – disable automatic OpenTone adjustment
OPENTONE_ENABLED=true

OPENTONE_MIN_TEMP=3000
OPENTONE_MAX_TEMP=6500
OPENTONE_SMOOTHING_FACTOR=0.3
OPENTONE_MIN_CHANGE_THRESHOLD=50

